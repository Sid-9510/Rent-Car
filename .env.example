# RentCar Environment Variables Example
# Copy these variables to your system environment or IDE run configuration

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/rentcar_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Configuration (Must be at least 256 bits / 32+ characters for HS256)
JWT_SECRET=RentCarSuperSecretKeyForJwtAuthentication2026SecureTokenGenerationKey
JWT_EXPIRATION_MS=86400000

# Application Configuration
APP_TAX_RATE=0.18
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api
